# This file mirrors every relevant .gitignore rule because EAS prioritizes it.

# version control and dependencies
/.git/
node_modules/
/.pnpm-store/

# Expo and generated bundles
.expo/
dist/
web-build/
expo-env.d.ts

# Native projects are generated by EAS Continuous Native Generation
/ios/
/android/
.kotlin/
*.orig.*

# credentials and local environment
*.jks
*.keystore
*.p8
*.p12
*.pfx
*.key
*.pem
*.cer
*.mobileprovision
.env
.env.*
.npmrc
/.codex/
google-services.json
GoogleService-Info.plist
credentials*.json
service-account*.json
/credentials/
/secrets/

# local tooling and logs
/.vscode/
/.github/
/quality/
.metro-health-check*
npm-debug.*
yarn-debug.*
yarn-error.*
.DS_Store
*.tsbuildinfo
/coverage/

# non-build repository material
/AGENTS.md
/CHANGELOG.md
/README.md
/STATO.md
/Avvia PWA.command
/docs/
/scripts/
/tests/
/tooling/
/eslint.config.js
/jest.config.js
/assets/audio/placeholders/
/public/audio-catalog/
/src/app-qa/
/src/qa/
/src/audio/reactNativeAudioApi/stemAssets.ts
/assets/audio/test-pack-01/
/public-pwa/
/src/app-pwa/
/src/pwa-review/
/output/
/tmp/
