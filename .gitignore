# Large local-only listening catalog served by the localhost preview.
# Fail closed for every present and future format. Only the reviewed README is
# admitted; future metadata needs an explicit path-level exception and review.
/public/audio-catalog/**
!/public/audio-catalog/README.md
# Reproducible PWA-only decoder; generated from pinned sources before export.
/public-pwa/flac-decoder.worker.min.js
