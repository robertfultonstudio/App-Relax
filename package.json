{
  "name": "ritual-audio-mvp",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo-google-fonts/manrope": "^0.4.2",
    "@expo-google-fonts/newsreader": "^0.4.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.20",
    "expo-asset": "~57.0.16",
    "expo-constants": "~57.0.17",
    "expo-dev-client": "~57.0.18",
    "expo-font": "~57.0.3",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.9",
    "expo-router": "~57.0.19",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-audio-api": "0.13.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@expo/eas-json": "21.6.0",
    "@react-native/jest-preset": "0.86.3",
    "@react-native/metro-config": "0.86.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/node": "^22.20.1",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "expo-doctor": "^1.20.1",
    "jest": "29.7.0",
    "jest-expo": "~57.0.5",
    "prettier": "^3.9.6",
    "react-test-renderer": "19.2.3",
    "test-renderer": "1.2.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "start:clear": "expo start --dev-client --clear",
    "device:android": "bash scripts/android-physical-device.sh",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web --localhost",
    "web:qa": "APP_RELAX_SURFACE=qa expo start --web --localhost",
    "web:pwa": "node scripts/start-pwa-web-preview.mjs",
    "web:iphone": "node scripts/start-iphone-web-preview.mjs",
    "web:iphone:review": "node scripts/start-iphone-web-preview.mjs --review",
    "export:web:consumer": "EXPO_PUBLIC_FOLDER=public-mobile expo export --clear --platform web --output-dir dist/m5-web-consumer",
    "export:web:qa": "APP_RELAX_SURFACE=qa EXPO_PUBLIC_FOLDER=public-mobile expo export --clear --platform web --output-dir dist/m5-web-qa",
    "export:web:pwa": "APP_RELAX_SURFACE=pwa EXPO_PUBLIC_FOLDER=public-pwa EXPO_PUBLIC_APP_RELAX_PWA=1 EXPO_PUBLIC_APP_RELAX_PWA_AUDIO=same-origin expo export --clear --platform web --output-dir dist/m5-pwa && node scripts/finalize-pwa-precache.mjs dist/m5-pwa",
    "export:ios:consumer": "EXPO_PUBLIC_FOLDER=public-mobile expo export --clear --platform ios",
    "export:android:consumer": "EXPO_PUBLIC_FOLDER=public-mobile expo export --clear --platform android",
    "export:validate-native": "node scripts/validate-native-export-audio-scope.mjs",
    "format:check": "prettier --check \"**/*.{js,mjs,json,md,ts,tsx}\"",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:audio": "jest --runInBand tests/audio",
    "test:crossfade": "jest --runInBand tests/audio/CrossfadeRobustness.test.ts tests/audio/AdaptiveWebPlayback.test.ts tests/audio/AdaptiveNativePlayback.test.ts tests/audio/AdaptiveSessionController.test.ts tests/domain/equalPower.test.ts tests/domain/workbench.test.ts tests/domain/futureMusicContract.test.ts tests/domain/continuumPlanner.test.ts tests/ui/qaTimelineScrubber.test.tsx tests/state/qaWorkbenchPersistence.test.ts",
    "audio:generate-placeholders": "node scripts/generate-placeholder-audio.mjs",
    "audio:validate-placeholders": "node scripts/validate-placeholder-audio.mjs",
    "audio:validate-test-pack": "node scripts/validate-test-pack-audio.mjs",
    "audio:validate-consumer": "node scripts/validate-consumer-audio.mjs",
    "audio:verify-lossless": "node scripts/verify-lossless-derivatives.mjs",
    "assets:validate-safety": "node scripts/validate-asset-safety.mjs",
    "assets:validate-rituals": "node scripts/validate-ritual-assets.mjs",
    "security:audit": "node scripts/validate-asset-safety.mjs && node scripts/validate-dependency-audit.mjs",
    "config:validate": "node scripts/validate-project-config.mjs",
    "qa:validate-boundary": "node scripts/validate-workbench-boundary.mjs",
    "qa:validate-exports": "node scripts/validate-workbench-exports.mjs",
    "pwa:validate": "node scripts/validate-pwa.mjs",
    "pwa:check-local": "node scripts/start-pwa-web-preview.mjs --check",
    "pwa:test-server": "node --test tests/scripts/pwaPreviewServer.test.mjs",
    "eas:validate-archive": "node scripts/validate-eas-archive.mjs",
    "expo:doctor": "expo-doctor",
    "config:public": "expo config --type public",
    "build:ios": "expo run:ios --no-bundler",
    "build:android": "expo run:android --no-bundler"
  },
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.16.0",
  "volta": {
    "node": "22.23.1",
    "pnpm": "11.16.0"
  }
}
